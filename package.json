{
	"name": "caitlyn",
	"version": "2.0.0",
	"description": "A Discord bot that has a little personality to it. It is a work in progress*",
	"main": "dist/main.js",
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11 <12"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"deploy": "tsx core/deployCommands.ts",
		"deploy:prod": "node dist/core/deployCommands.js",
		"dev": "tsx main.ts",
		"dev:watch": "tsx watch main.ts",
		"start": "node dist/main.js",
		"test": "node --test",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RazeViana/Caitlyn.git"
	},
	"keywords": [
		"discord",
		"bot"
	],
	"author": "Raze Viana",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/RazeViana/Caitlyn/issues"
	},
	"homepage": "https://github.com/RazeViana/Caitlyn#readme",
	"dependencies": {
		"date-fns": "^4.1.0",
		"discord.js": "^14.18.0",
		"dotenv": "^16.5.0",
		"node-cron": "^3.0.3",
		"node-fetch": "^3.3.2",
		"pg": "^8.14.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.24.0",
		"@types/node": "^24.13.3",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.23.1",
		"discord-api-types": "^0.38.55",
		"eslint": "^9.24.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2"
	}
}
