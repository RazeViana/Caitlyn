# ==========================
#      Discord Config
# ==========================
# TOKEN is the only setting required for bot startup. Missing/invalid optional
# feature settings are logged by name and disable that feature (never log values).
# CLIENT_ID and GUILD_ID are required separately for guild command deployment.
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_server_id_here
GENERAL_CHAT_ID=your_channel_id_here
# GUILD_ID + GENERAL_CHAT_ID + database settings enable birthday reminders.
# Optional; omit to preserve the host timezone. Reminders are due at 9 AM,
# checked every five minutes, with catch-up only until local midnight.
# BIRTHDAY_TIMEZONE=Europe/Brussels

# ==========================
#         GIF API
# ==========================
GIPHY_API_KEY=your_giphy_api_key_here
# Optional; without it birthdays still work, with no GIF API requests.

# ==========================
#    PostgreSQL Config
# ==========================
# All five settings are required to enable database-backed features. If absent,
# activity, birthday storage/reminders, AI memory, social jobs and Discord log
# forwarding stay disabled. Basic commands and configured AI chat remain usable.
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=your_database_password
PGDATABASE=caitlyn
PGPORT=5432

# ==========================
#    Open WebUI / LLM
# ==========================
# Optional; defaults to false. All three AI connection settings are needed to
# configure chat. /toggleai refuses to enable it while any are missing/invalid.
LLM_ENABLED=false
OLLAMA_MODEL=gemma3:12b
WEBUI_API_KEY=your_webui_api_key_here
WEBUI_CHAT_ENDPOINT=http://localhost:8080/api/chat/completions

# Configure the system prompt in the Open WebUI model settings.

# ==========================
#   Vector Memory Config
# ==========================
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_ENDPOINT=http://localhost:11434/api/embeddings
# Optional; missing embedding/database settings disable memory, not AI replies.
# Optional nonnegative integers; defaults are 5 recent and 3 similar messages.
CONTEXT_RECENT_COUNT=8
CONTEXT_SIMILAR_COUNT=3

# ==========================
#      Logging Config
# ==========================
# Optional; defaults to INFO.
# This filters console output only. Select Discord log types in the private
# logging channel with /logs levels; no Discord channel ID belongs in this file.
LOG_LEVEL=INFO

# Off until the operator enables this connection AND an administrator opts a
# text channel in using /social enable. Never mount Docker's socket in the bot.
# Missing/invalid socket or database settings disable integration with a startup warning.
SOCIAL_MEDIA_ENABLED=false
# SOCIAL_WORKER_SOCKET=/run/caitlyn-media/worker.sock
# Broker-only settings; export when starting scripts/socialWorker/server.ts.
# FxEmbed is the only provider. The older direct/VX modes are removed.
# SOCIAL_X_PROVIDER=fxembed
# Loopback URL only; first build/start the backend as described in docs/fxembed.md.
# SOCIAL_FXEMBED_URL=http://127.0.0.1:8787
# SOCIAL_WORKER_IMAGE=caitlyn-media-api:local
# SOCIAL_WORKER_DOCKER_CONTEXT=default

# ==========================
#   Local FxEmbed X Account
# ==========================
# Optional; only scripts/fxEmbed/manage.ts start-env reads these fields.
# Copy the handle (without @) and complete cookie values into your private .env.
# Never commit real values. Protect .env with chmod 600 .env.
# Bot/broker configuration loading excludes FXEMBED_X_* from process.env.
FXEMBED_X_USERNAME=
FXEMBED_X_AUTH_TOKEN=
FXEMBED_X_CT0=
# The broker uses a separate local API key file, never the X account cookies.
# SOCIAL_FXEMBED_KEY_FILE=/run/caitlyn-media/fxembed.key
